---
// src/components/HeroNew.astro
---

<section class="relative w-full min-h-[calc(100vh-80px)] flex items-center justify-center overflow-hidden bg-dark-bg px-6 md:px-12 py-20">
  
  <!-- Fondo Geométrico de Alta Gama (Líneas de Grid sutiles en CSS puro) -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f2937_1px,transparent_1px),linear-gradient(to_bottom,#1f2937_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-20 pointer-events-none"></div>
  
  <!-- Aura de brillo de acento en el fondo (Glassmorphism indirecto) -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-accent/5 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-4xl mx-auto text-center space-y-8 relative z-10">
    
    <!-- Etiqueta de Enfoque Corporativo -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-accent/20 bg-accent/[0.02] backdrop-blur-sm animate-fade-in">
      <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
      <span class="font-mono text-[10px] md:text-xs uppercase tracking-widest text-accent">
        Castro Studio // Ingeniería de Software B2B
      </span>
    </div>

    <!-- Titular Principal (Headline) -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tighter text-soft-white leading-[1.1] md:leading-[1.05]">
      Automatizamos tu operación.<br />
      <span class="bg-gradient-to-r from-gray-400 via-gray-500 to-gray-600 bg-clip-text text-transparent">
        Multiplicamos tu rentabilidad.
      </span>
    </h1>

    <!-- Subtítulo Estratégico (Value Proposition) -->
    <p class="max-w-2xl mx-auto text-sm md:text-lg text-gray-400 font-sans leading-relaxed">
      Diseñamos e implementamos software a medida y arquitecturas de automatización con <strong class="text-soft-white font-medium">n8n (Self-Hosted)</strong>. Eliminamos las tareas repetitivas de tu equipo, reducimos errores y blindamos tus datos, todo sin pagar suscripciones prohibitivas de software.
    </p>

    <!-- Botones de Acción Métricas (CTAs) -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <a 
        href="#contacto" 
        class="w-full sm:w-auto font-mono text-xs md:text-sm uppercase tracking-wider text-dark-bg bg-accent hover:bg-accent/90 px-8 py-4 rounded-full font-bold shadow-[0_4px_30px_rgba(var(--accent-rgb),0.2)] transition-all duration-300 hover:scale-[1.02] text-center"
      >
        Agendar Consultoría Gratuita
      </a>
      <a 
        href="#roi" 
        class="w-full sm:w-auto font-mono text-xs md:text-sm uppercase tracking-wider text-gray-400 hover:text-soft-white bg-bg-card/40 border border-border-custom hover:border-gray-500 px-8 py-4 rounded-full transition-all duration-300 text-center backdrop-blur-sm"
      >
        Calcular Fuga de Capital ↓
      </a>
    </div>

    <!-- Micro-Prueba Social / Enfoque de Solución -->
    <div class="pt-12 grid grid-cols-2 md:grid-cols-3 gap-6 max-w-2xl mx-auto border-t border-border-custom/30 text-left">
      <div class="space-y-1">
        <span class="block font-mono text-xs uppercase tracking-wider text-gray-500">Tecnología Core</span>
        <span class="block text-sm font-bold text-soft-white font-sans">n8n / Astro / Go / Docker</span>
      </div>
      <div class="space-y-1">
        <span class="block font-mono text-xs uppercase tracking-wider text-gray-500">Modelo Cloud</span>
        <span class="block text-sm font-bold text-soft-white font-sans">100% Self-Hosted & Seguro</span>
      </div>
      <div class="col-span-2 md:col-span-1 space-y-1">
        <span class="block font-mono text-xs uppercase tracking-wider text-gray-500">Enfoque Regional</span>
        <span class="block text-sm font-bold text-accent font-sans">Localizado para Colombia</span>
      </div>
    </div>

  </div>
</section>