---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();

const links = {
  soluciones: [
    { label: "Orquestación n8n", href: "#servicios" },
    { label: "Desarrollo Full-Stack", href: "#servicios" },
    { label: "Integración de APIs", href: "#servicios" },
    { label: "Soporte & Optimización", href: "#contacto" }
  ],
  navegacion: [
    { label: "Inicio", href: "#" },
    // { label: "Casos de Éxito", href: "#proyectos" },
    { label: "Calculadora ROI", href: "#roi" },
    { label: "Contacto", href: "#contacto" }
  ]
};
---

<footer class="w-full bg-dark-bg border-t border-border-custom relative overflow-hidden">
  <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-accent/30 to-transparent"></div>

  <div class="max-w-6xl mx-auto px-6 md:px-12 py-16 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-8">
      
      <div class="md:col-span-2 space-y-6">
        <div class="flex items-center gap-3">
          <div class="h-5 w-5 rotate-45 border border-accent bg-accent/10 flex items-center justify-center shadow-[0_0_15px_rgba(var(--accent-rgb),0.2)]"></div>
          <span class="font-mono text-lg font-bold tracking-tighter text-soft-white">
            CASTRO<span class="text-accent">.</span>STUDIO
          </span>
        </div>
        
        <p class="text-sm text-gray-400 max-w-sm leading-relaxed">
          Diseño e ingeniería de infraestructura digital automatizada para optimizar operaciones empresariales sin costos ocultos de licencias.
        </p>

        <div class="inline-flex items-center gap-2.5 bg-bg-card border border-border-custom px-3 py-1.5 rounded-full text-xs font-mono text-gray-400">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          Sistema Operativo • Disponible Q2 2026
        </div>
      </div>

      <div class="space-y-4">
        <h4 class="font-mono text-xs uppercase tracking-widest text-gray-500">// Soluciones</h4>
        <ul class="space-y-2.5">
          {links.soluciones.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-accent transition-colors duration-200 block">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-4">
        <h4 class="font-mono text-xs uppercase tracking-widest text-gray-500">// Navegación</h4>
        <ul class="space-y-2.5">
          {links.navegacion.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-accent transition-colors duration-200 block">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <div class="mt-16 pt-8 border-t border-border-custom flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-6 text-xs text-gray-500 font-mono text-center sm:text-left">
        <span>© {currentYear} CASTRO.STUDIO. Todos los derechos reservados.</span>
        <span class="hidden sm:inline text-gray-800">|</span>
        <span class="text-gray-600">Bogotá, CO (GMT-5)</span>
      </div>
      
      <div class="flex items-center gap-1.5 font-mono text-[11px] text-gray-500 bg-bg-card border border-border-custom px-3 py-1 rounded-md">
        <span>Built with</span>
        <span class="text-orange-500">Astro</span>
        <span>&amp;</span>
        <span class="text-accent font-bold">Tailwind v4</span>
      </div>
    </div>

  </div>
</footer>