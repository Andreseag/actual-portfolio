---
// src/pages/og-template.astro
import '../styles/global.css'; // Asegúrate de apuntar a tu archivo de Tailwind v4
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>OG Image Generator</title>
    <style>
      /* Forzamos el viewport exacto de Open Graph para el screenshot */
      body {
        width: 1200px;
        height: 630px; 
        overflow: hidden;
      }
    </style>
  </head>
  <body class="bg-[#0B0F17] text-[#F3F4F6] font-sans relative flex flex-col justify-between p-16 select-none antialiased">
    
    <!-- Grid Técnico de Fondo (Mismo del HeroNew) -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f2937_1px,transparent_1px),linear-gradient(to_bottom,#1f2937_1px,transparent_1px)] bg-[size:4rem_4rem] opacity-20 pointer-events-none"></div>
    
    <!-- Aura de Brillo de Acento de fondo -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[rgba(0,240,255,0.04)] blur-[130px] rounded-full pointer-events-none"></div>

    <!-- HEADER DE LA TARJETA --> 
    <div class="flex items-center justify-between relative z-10">
      <div class="flex items-center gap-3">
        <!-- Isotipo Favicon Minimimalista -->
        <div class="h-7 w-7 rotate-45 border-2 border-[#00F0FF] bg-[#00F0FF]/10 flex items-center justify-center shadow-[0_0_15px_rgba(0,240,255,0.3)]"></div>
        <span class="font-mono text-xl font-bold tracking-tighter">
          CASTRO<span class="text-[#00F0FF]">.</span>STUDIO
        </span>
      </div>
      <div class="font-mono text-xs uppercase tracking-widest text-gray-500 border border-gray-800 px-3 py-1 rounded bg-gray-900/40">
        // INGENIERÍA DE SOFTWARE B2B
      </div>
    </div>

    <!-- CUERPO PRINCIPAL (PROPUESTA DE VALOR) -->
    <div class="space-y-6 max-w-4xl relative z-10 my-auto">
      <h1 class="text-5xl md:text-6xl font-extrabold tracking-tighter leading-[1.1] text-white">
        Automatizamos tu operación.<br />
        <span class="bg-gradient-to-r from-gray-400 via-gray-500 to-gray-600 bg-clip-text text-transparent">
          Multiplicamos tu rentabilidad.
        </span>
      </h1>
      <p class="text-xl text-gray-400 font-sans max-w-2xl leading-relaxed">
        Arquitecturas de automatización con <span class="text-white font-medium">n8n (Self-Hosted)</span> e integraciones cloud a medida para PYMEs y empresas.
      </p>
    </div>

    <!-- FOOTER DE LA TARJETA -->
    <div class="flex items-center justify-between border-t border-gray-800/60 pt-8 relative z-10">
      <!-- Stack Core -->
      <div class="flex gap-3">
        {["n8n", "Astro", "Go", "Docker"].map((tech) => (
          <span class="text-xs font-mono text-gray-400 bg-gray-900/60 border border-gray-800 px-3 py-1 rounded-md">
            {tech}
          </span>
        ))}
      </div>
      
      <!-- Validación de Enfoque -->
      <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-gray-500">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Infraestructura 100% Segura y Privada
      </div>
    </div>

  </body>
</html>